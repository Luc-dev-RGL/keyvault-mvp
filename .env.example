# =============================================================
# KeyVault - Variables d'environnement
# Copiez ce fichier : cp .env.example .env
# puis completez les valeurs ci-dessous.
# =============================================================

# --- Base de donnees PostgreSQL (Docker local, voir docker-compose.yml) ---
DATABASE_URL=postgresql://keyvault:keyvault@localhost:5432/keyvault?schema=public

# --- Cle maitre de chiffrement des secrets (AES-256-GCM) ---
# Format : 64 caracteres hexadecimaux (32 octets)
# Generer : openssl rand -hex 32
# ATTENTION : si vous changez cette cle, tous les secrets
# chiffres deviennent definitivement illisibles.
APP_ENCRYPTION_KEY=CHANGER_MOI_openssl_rand_hex_32

# --- Secret de signature des sessions (JWT HS256) ---
# Generer : openssl rand -hex 32
SESSION_SECRET=CHANGER_MOI_openssl_rand_hex_32

# --- Compte administrateur initial (script de seed) ---
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@mon-organisation.com
ADMIN_PASSWORD=AChanger1erConnect
